ANTHROPIC_API_KEY=your_anthropic_key_here

# ── EagleView Property Data V2 API ──────────────────────────────────────────
# Leave blank to use mock mode (instant deterministic data, no API calls).
# Obtain credentials from: https://developers.eagleview.com
#
# EAGLEVIEW_TOKEN_URL — OAuth2 token endpoint from your developer portal
#                       (not in the OpenAPI spec; provided separately at onboarding)
# EAGLEVIEW_SANDBOX   — set to "true" to hit sandbox.apis.eagleview.com
#                       Sandbox is limited to a ~1.5 sq mi box in Omaha, NE.
# EAGLEVIEW_PRODUCT_IDS — comma-separated product IDs to request per property.
#                         Defaults: 001 (area), 002 (pitch), 003 (material), 004 (age), 008 (imagery)
#
# Product ID reference:
#   property_data_id_001  Roof Area Estimate
#   property_data_id_002  Roof Pitch and Eave Height
#   property_data_id_003  Roof Material & Condition
#   property_data_id_004  Roof Age
#   property_data_id_005  Property Condition & Details
#   property_data_id_006  Risk & Vulnerability Scores
#   property_data_id_007  Building Outlines
#   property_data_id_008  Property Ortho Imagery
#   property_data_id_009  Property Oblique Imagery

EAGLEVIEW_CLIENT_ID=
EAGLEVIEW_CLIENT_SECRET=
EAGLEVIEW_TOKEN_URL=
EAGLEVIEW_SANDBOX=true
EAGLEVIEW_PRODUCT_IDS=

# ── Document search (optional) ──────────────────────────────────────────────
# Without this key, the bot searches uploaded documents by keyword.
# With it, it also searches by meaning. Get a key at https://www.voyageai.com
VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-3.5
